{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "confidence", "category"],
  "properties": {
    "decision": {
      "type": "string",
      "enum": ["allow", "review", "block"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "category": {
      "type": "string",
      "enum": [
        "safe",
        "abuse",
        "harassment",
        "sexual",
        "violence",
        "illegal",
        "spam",
        "privacy",
        "other"
      ]
    }
  }
}
