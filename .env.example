# Feishu custom-app credentials. Create a separate app for development and production.
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Optional agent runtime configuration.
# Defaults to the project directory when omitted.
DEFAULT_CWD=
# Codex CLI model. Leave empty to use your Codex configuration default.
CODEX_MODEL=
# read-only, workspace-write, or danger-full-access. Keep workspace-write unless necessary.
CODEX_SANDBOX_MODE=workspace-write
# Path to the codex executable. Leave empty to use PATH.
CODEX_BIN=
# Optional isolated Codex home. Production should use a dedicated, pre-authorized CODEX_HOME.
CODEX_HOME=
# Optional runtime data paths. Docker sets these automatically; local runs
# default to session/knowledge/contacts.md and tasks.json in this repository.
CONTACTS_FILE=
TASKS_FILE=

# When true, any group chat received by this bot is authorized without adding
# every chat_id to contacts.md. Direct messages still require an allowed user.
GROUP_ACCESS_ALL=false
# When true, moderation covers every authorized group event instead of only
# chats explicitly listed in contacts.md.
MODERATION_ALL_GROUPS=false

# Optional AI-backed group-message moderation. Keep recall disabled while testing.
MODERATION_ENABLED=false
MODERATION_RECALL_ENABLED=false
MODERATION_ENGINE=codex
MODERATION_GROUP_ONLY=true
# Optional fast deterministic prefilter before calling Codex.
MODERATION_RULES_PREFILTER=true
MODERATION_KEYWORDS=
# Semicolon-separated regexes, matched after lowercasing and removing spaces/separators.
MODERATION_REGEXES=
# Block only when model confidence >= threshold.
MODERATION_CONFIDENCE_THRESHOLD=0.9
# Warn-only tier: block decisions with confidence in [warn, threshold) get a reminder card instead of recall.
MODERATION_WARN_THRESHOLD=0.7
MODERATION_TIMEOUT_MS=15000
MODERATION_CONCURRENCY=2
MODERATION_QUEUE_LIMIT=100
MODERATION_MAX_TEXT_LENGTH=4000
# Optional separate model for moderation; defaults to CODEX_MODEL.
MODERATION_CODEX_MODEL=
# Comma-separated open_id exemption list.
MODERATION_EXEMPT_OPEN_IDS=
MODERATION_NOTIFY_ADMIN=false
MODERATION_AUDIT_FILE=logs/moderation-audit.jsonl
# Optional custom moderation policy. Defaults to a conservative enterprise policy.
MODERATION_POLICY=

# 自动广告撤回（ad-recall）为策略配置而非机密，位于 config/ad-recall.json，随 git 同步。
# 字段说明与默认值见该文件及 README「Ad recall」一节。
