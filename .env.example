# Feishu custom-app credentials. Create a separate app for development and production.
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Optional agent runtime configuration.
# Defaults to the project directory when omitted.
DEFAULT_CWD=
# Codex CLI model. Leave empty to use your Codex configuration default.
CODEX_MODEL=
# read-only, workspace-write, or danger-full-access. Keep workspace-write unless necessary.
CODEX_SANDBOX_MODE=workspace-write
# Path to the codex executable. Leave empty to use PATH.
CODEX_BIN=
# Optional isolated Codex home. Production should use a dedicated, pre-authorized CODEX_HOME.
CODEX_HOME=
# Optional runtime data paths. Docker sets these automatically; local runs
# default to session/knowledge/contacts.md and tasks.json in this repository.
CONTACTS_FILE=
TASKS_FILE=
